  "components": {
    "schemas": {
      "CreateSessionZeroDraft": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "requestId": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid"
          },
          "command": {
            "type": "string",
            "const": "create_session_zero_draft",
            "title": "Command",
            "default": "create_session_zero_draft"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId"
        ],
        "title": "CreateSessionZeroDraft"
      },
      "DraftResult": {
        "properties": {
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "commitBoundary": {
            "type": "string",
            "const": "draft",
            "title": "Commitboundary",
            "default": "draft"
          },
          "committedRevision": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Committedrevision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "committedRevision"
        ],
        "title": "DraftResult"
      },
      "EmptySaveSlot": {
        "properties": {
          "number": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Number"
          },
          "status": {
            "type": "string",
            "const": "empty",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "status"
        ],
        "title": "EmptySaveSlot",
        "description": "An explicitly empty numbered slot; for example, EmptySaveSlot(number=1, status='empty')."
      },
      "Operation": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "operationId": {
            "type": "string",
            "pattern": "^op_[0-9a-f-]{36}$",
            "title": "Operationid"
          },
          "requestId": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid"
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "validating",
              "committed",
              "complete",
              "failed",
              "interrupted"
            ],
            "title": "Status"
          },
          "commitBoundary": {
            "type": "string",
            "enum": [
              "none",
              "draft"
            ],
            "title": "Commitboundary"
          },
          "committedRevision": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Committedrevision"
          },
          "lastEventId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Lasteventid"
          },
          "recovery": {
            "$ref": "#/components/schemas/RecoveryCapability"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "statusUrl": {
            "type": "string",
            "title": "Statusurl"
          },
          "eventsUrl": {
            "type": "string",
            "title": "Eventsurl"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operationId",
          "requestId",
          "subject",
          "status",
          "commitBoundary",
          "committedRevision",
          "lastEventId",
          "recovery",
          "result",
          "statusUrl",
          "eventsUrl"
        ],
        "title": "Operation"
      },
      "OperationEvent": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "eventId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Eventid"
          },
          "operation": {
            "$ref": "#/components/schemas/Operation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eventId",
          "operation"
        ],
        "title": "OperationEvent"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "enum": [
              404,
              409,
              422,
              503
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "request_conflict",
              "operation_not_found",
              "operation_unavailable",
              "draft_not_committed",
              "draft_not_found",
              "draft_unavailable",
              "draft_already_committed",
              "event_history_unavailable",
              "invalid_event_cursor",
              "stale_event",
              "recovery_not_supported",
              "application_data_busy"
            ],
            "title": "Code"
          },
          "classification": {
            "type": "string",
            "enum": [
              "conflict",
              "invalid_input",
              "not_found",
              "unavailable"
            ],
            "title": "Classification"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "correlationId": {
            "type": "string",
            "title": "Correlationid"
          },
          "operation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Operation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "classification",
          "instance",
          "correlationId"
        ],
        "title": "Problem"
      },
      "RecoveryCapability": {
        "properties": {
          "retry": {
            "type": "boolean",
            "title": "Retry"
          },
          "cancel": {
            "type": "boolean",
            "title": "Cancel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "retry",
          "cancel"
        ],
        "title": "RecoveryCapability"
      },
      "RecoveryCommand": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "requestId": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Requestid"
          },
          "expectedLastEventId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Expectedlasteventid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestId",
          "expectedLastEventId"
        ],
        "title": "RecoveryCommand"
      },
      "SaveSlotsResponse": {
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/components/schemas/EmptySaveSlot"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slots"
        ],
        "title": "SaveSlotsResponse",
        "description": "The current three-slot index; for example, SaveSlotsResponse(slots=[])."
      },
      "SessionZeroDraft": {
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1,
            "title": "Schemaversion",
            "default": 1
          },
          "draftId": {
            "type": "string",
            "pattern": "^draft_[0-9a-f-]{36}$",
            "title": "Draftid"
          },
          "draftRevision": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Draftrevision"
          },
          "lifecycle": {
            "type": "string",
            "const": "collecting",
            "title": "Lifecycle",
            "default": "collecting"
          },
          "activeOperationId": {
            "type": "string",
            "title": "Activeoperationid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "draftId",
          "draftRevision",
          "activeOperationId"
        ],
        "title": "SessionZeroDraft"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
