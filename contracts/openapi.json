{
  "openapi": "3.1.0",
  "info": {
    "title": "dmud API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Get Status",
        "description": "Report readiness without configuration; for example, GET /api/status.",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/save-slots": {
      "get": {
        "summary": "Get Save Slots",
        "description": "Read the foundation's empty index without opening branch state; for example, GET /api/save-slots.",
        "operationId": "getSaveSlots",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveSlotsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmptySaveSlot": {
        "properties": {
          "number": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "title": "Number"
          },
          "status": {
            "type": "string",
            "const": "empty",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "status"
        ],
        "title": "EmptySaveSlot",
        "description": "An explicitly empty numbered slot; for example, EmptySaveSlot(number=1, status='empty')."
      },
      "SaveSlotsResponse": {
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/components/schemas/EmptySaveSlot"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slots"
        ],
        "title": "SaveSlotsResponse",
        "description": "The current three-slot index; for example, SaveSlotsResponse(slots=[])."
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "description": "Describe the read-only application readiness response; for example, StatusResponse(status='ready')."
      }
    }
  }
}
